\newlabel{tab:anova}{{4}{8}{Type III ANOVA Results for LLM-as-Judge Score. Main effects only; interaction terms were excluded due to empty cells arising from domain--query-type confounding (medical and finance domains contain only single-hop queries). $\eta ^2_p$ = partial eta squared}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Tukey HSD post-hoc pairwise comparisons by domain for LLM-as-Judge Score. Mean difference = Group A $-$ Group B (positive values indicate Group A scores higher). 95\% CI = confidence interval for mean difference. Cohen's \textit  {d} computed using pooled SD. ns = not significant.}}{8}{table.5}\protected@file@percent }
\newlabel{tab:tukey_domain}{{5}{8}{Tukey HSD post-hoc pairwise comparisons by domain for LLM-as-Judge Score. Mean difference = Group A $-$ Group B (positive values indicate Group A scores higher). 95\% CI = confidence interval for mean difference. Cohen's \textit {d} computed using pooled SD. ns = not significant}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Tukey HSD post-hoc pairwise comparisons by query type for LLM-as-Judge Score. Mean difference = Group A $-$ Group B (positive values indicate Group A scores higher). 95\% CI = confidence interval for mean difference. Cohen's \textit  {d} computed using pooled SD. ns = not significant.}}{9}{table.6}\protected@file@percent }
\newlabel{tab:tukey_querytype}{{6}{9}{Tukey HSD post-hoc pairwise comparisons by query type for LLM-as-Judge Score. Mean difference = Group A $-$ Group B (positive values indicate Group A scores higher). 95\% CI = confidence interval for mean difference. Cohen's \textit {d} computed using pooled SD. ns = not significant}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Tukey HSD post-hoc pairwise comparisons by chunking strategy for LLM-as-Judge Score. Mean difference = Group A $-$ Group B (positive values indicate Group A scores higher). 95\% CI = confidence interval for mean difference. Cohen's \textit  {d} computed using pooled SD. All significant pairs involve \texttt  {fixed\_128} as the lower-scoring group; effect sizes are negligible throughout ($d < 0.20$), consistent with the small ANOVA $\eta ^2_p = .003$.}}{9}{table.7}\protected@file@percent }
\newlabel{tab:tukey_strategy}{{7}{9}{Tukey HSD post-hoc pairwise comparisons by chunking strategy for LLM-as-Judge Score. Mean difference = Group A $-$ Group B (positive values indicate Group A scores higher). 95\% CI = confidence interval for mean difference. Cohen's \textit {d} computed using pooled SD. All significant pairs involve \texttt {fixed\_128} as the lower-scoring group; effect sizes are negligible throughout ($d < 0.20$), consistent with the small ANOVA $\eta ^2_p = .003$}{table.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Welch's \textit  {t}-test: Finance vs.\ General on (LLM Judge Score $-$ Faithfulness). Negative mean difference indicates Finance scores are lower on this combined metric. Cohen's \textit  {d} computed using pooled SD.}}{10}{table.8}\protected@file@percent }
\newlabel{tab:targeted_contrast}{{8}{10}{Welch's \textit {t}-test: Finance vs.\ General on (LLM Judge Score $-$ Faithfulness). Negative mean difference indicates Finance scores are lower on this combined metric. Cohen's \textit {d} computed using pooled SD}{table.8}{}}
